{
  "manifest_version": 3,
  "name": "JESTER Deep Research Companion",
  "version": "1.1",
  "description": "Allows JESTER to analyze and extract deep research from the active browser tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JESTER Deep Research"
  },
  "background": {
    "service_worker": "background.js"
  }
}

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Sensitive files
*.env.bak
*.bak
*.db
__pycache__/
*.pyc
*.zip

# Shared secret for the local API (GOD_HAND_CORE/jester_auth.py). Generated on
# first run, machine-local, and must never be committed -- committing it would
# hand every clone the token that guards /api/sandbox.
.jester_token

# Local git worktrees. A worktree directory contains a .git *file*, which git
# mistakes for a submodule and records as a gitlink (mode 160000). One was
# committed that way, giving anyone who cloned this repo a submodule reference
# pointing at a commit that only existed on the original machine.
*.worktrees/
.claude/worktrees/

# Claude Code local state, including settings.local.json (machine-specific
# permissions). Untracked but easy to sweep in with `git add -A`.
.claude/

# Atlassian CLI
acli.exe

# JESTER runtime config / local artifacts (machine-local, not for clones)
GOD_HAND_CORE/mcp_servers.json
*.err
jester_ai_test.html
public/puter_probe.html

# Runtime STATE: tracked binaries + DBs held open by the running server. A git
# hard-reset (the in-app upgrader) tried to unlink them while Chroma memory-maps
# data_level0.bin on Windows -> "unable to unlink ... Invalid argument" and a
# half-finished reset. These are regenerable state, never version them.
GOD_HAND_CORE/chroma_db/
GOD_HAND_CORE/jester_V73_OMNIPRESENCE.db
GOD_HAND_CORE/jester_memory.db
GOD_HAND_CORE/jester_xp.json
# Swarm cache mmap + channel state: rewritten on every fleet_sync (regenerable)
GOD_HAND_CORE/.swarm_cache.mmap
GOD_HAND_CORE/.swarm_channels/
test_puter.mjs
GOD_HAND_CORE/script.py
